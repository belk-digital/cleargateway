# --- Runtime ---
NODE_ENV=development            # development | test | production
LOG_LEVEL=info                  # pino level
PORT=3000
HOST=0.0.0.0

# --- Data stores (matches docker-compose.yml) ---
DATABASE_URL=postgres://belk:belk@localhost:5433/belkpay
REDIS_URL=redis://localhost:6379

# --- Chain (Base Sepolia = 84532; mainnet 8453 is NOT enabled in Phase 1) ---
CHAIN_ID=84532
RPC_URL=https://sepolia.base.org
# Circle USDC on Base Sepolia (verified 2026-09-25: developers.circle.com/stablecoins/usdc-contract-addresses)
USDC_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e
# Filled after deploying ClearGatewaySplitter (see contracts/README section in SECURITY.md / deploy script)
SPLITTER_ADDRESS=
# Deploy-time only (contracts/script/DeploySepolia.s.sol): address of the backend signer (public address, not the key)
SIGNER_ADDRESS=
# Deploy-time only: contract owner (use a multisig/hardware wallet, not the signer)
OWNER_ADDRESS=
# Deploy-time only: max fee accepted by the contract, in bps
MAX_FEE_BPS=1000
CONFIRMATIONS=5
# Deposit-address factory (deploy: contracts/script/DeployDepositFactory.s.sol, Base Sepolia only)
DEPOSIT_FACTORY_ADDRESS=

# --- Platform ---
# Platform fee recipient wallet (checksummed address)
PLATFORM_WALLET_ADDRESS=
# Checkout origin (CORS allowlist) and hosted checkout base URL
CHECKOUT_ORIGIN=http://localhost:3001
CHECKOUT_BASE_URL=http://localhost:3001/pay

# --- Secrets (never commit real values) ---
# OPTIONAL legacy shared secret for scripts calling /internal (min 32 chars). Staff normally sign in with their own
# password + authenticator app, so leave this EMPTY in production. Generate: openssl rand -hex 32
ADMIN_TOKEN=
# 32-byte hex HMAC key deriving checkout client secrets (required to create payment intents). Generate: openssl rand -hex 32
CLIENT_SECRET_KEY=
# 32-byte hex key for encrypting webhook secrets and staff two-factor secrets at rest (required for staff sign-in). Generate: openssl rand -hex 32
ENCRYPTION_KEY=
# EIP-712 signer key. TESTNET ONLY. Leave empty until Milestone 3.
SIGNER_PRIVATE_KEY=

# --- API hardening ---
# Trust X-Forwarded-For only when running behind a proxy you control (else IPs can be spoofed)
TRUST_PROXY=false
RATE_LIMIT_PER_KEY_PER_MIN=600
RATE_LIMIT_PER_IP_PER_MIN=300
# Per-IP limit for sign-in / invite routes (public, brute-force targets)
AUTH_RATE_LIMIT_PER_MIN=10
# Max lifetime of a signed wallet-payment payload, in seconds
SIGNATURE_MAX_TTL_SECONDS=1800

# --- API: webhooks ---
# DEV/TEST ONLY: allow http:// and private-network webhook URLs (turns the SSRF guard off). Never true in production.
WEBHOOK_ALLOW_PRIVATE_URLS=false
# Shared secret for the "mock" chain-webhook provider (POST /webhooks/chain/mock, header x-cleargateway-mock-signature). Dev/tests only.
CHAIN_WEBHOOK_MOCK_SECRET=

# --- API: on-ramp (card / Apple Pay via a third-party on-ramp) ---
# Shared secret for the "mock" on-ramp provider (POST /webhooks/onramp/mock, header x-mock-onramp-signature). Dev/tests
# only; Wert (primary) and Simplex (secondary) are stubs pending sandbox credentials and need no secret yet.
ONRAMP_MOCK_SECRET=

# --- Worker (apps/worker) ---
# First block to scan on a fresh database: set to the splitter deployment block. Unset = start at the chain head.
WATCHER_START_BLOCK=
# Max blocks per getLogs call (keep under your RPC provider limit)
WATCHER_MAX_RANGE=1000
# On a detected reorg, rewind the watcher cursor this many blocks
REORG_REWIND_BLOCKS=20
# A confirming payment whose receipt is missing this long is failed as reorged-out
REORG_GRACE_SECONDS=600
# Unpaid on-chain-payable intents are expired only this long after expires_at (in-flight tx safety margin)
EXPIRY_GRACE_SECONDS=120
# If the watcher heartbeat is older than this, expiry of payable intents is paused
WATCHER_STALE_SECONDS=300
# Reconciliation lookback when WATCHER_START_BLOCK is unset
RECONCILE_MAX_LOOKBACK_BLOCKS=200000
WEBHOOK_TIMEOUT_MS=10000
WATCHER_INTERVAL_MS=5000
CONFIRMATIONS_INTERVAL_MS=5000
EXPIRY_INTERVAL_MS=30000
WEBHOOK_INTERVAL_MS=5000
# Deposit-address watcher (needs DEPOSIT_FACTORY_ADDRESS and USDC_ADDRESS; disabled otherwise)
DEPOSIT_INTERVAL_MS=5000
# Keep watching a deposit address this long after creation (late deposits are flagged for review)
DEPOSIT_LATE_LOOKBACK_DAYS=30

# --- Worker: sweeper (moves confirmed deposits into the splitter; needs the two vars below or sweeping is disabled) ---
SWEEP_INTERVAL_MS=5000
# Reuses SIGNER_PRIVATE_KEY (declared above, under API) for signing sweep intents: same backend key, same role, both the API and the worker read it.
# Gas-only relayer key. Holds no authority over funds: DepositFactory.sweep() is permissionless and its recipients
# are fixed by the signed intent, so this key can only pay gas, never redirect a payment. TESTNET ONLY.
RELAYER_PRIVATE_KEY=
# How long a sweep signature stays valid; minted fresh at send time, never in advance
SWEEP_SIGNATURE_TTL_SECONDS=600
# Give up on a sweep attempt after this many tries and flag the intent for review
SWEEP_MAX_ATTEMPTS=10
# Minimum time between sweep attempts for the same address
SWEEP_RETRY_BACKOFF_SECONDS=30

# --- Worker: on-ramp processor (applies already-verified on-ramp webhooks; never marks a payment succeeded) ---
ONRAMP_INTERVAL_MS=5000
ONRAMP_BATCH_SIZE=50

# Daily reconciliation (cron, server time)
RECONCILE_CRON="0 3 * * *"
# Local Anvil for E2E tests: docker compose up -d anvil (chain id 84532)
ANVIL_RPC_URL=http://127.0.0.1:8545

# --- Optional ---
SENTRY_DSN=

# --- Web app: see apps/web/.env.example (API_BASE_URL, NEXT_PUBLIC_API_BASE_URL, SESSION_SECRET) ---
