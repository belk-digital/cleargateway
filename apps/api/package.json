{
  "name": "@belk/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run"
  },
  "dependencies": {
    "@belk/db": "workspace:*",
    "@belk/shared": "workspace:*",
    "@fastify/cors": "^11.0.0",
    "@fastify/helmet": "^13.0.0",
    "@fastify/swagger": "^9.5.0",
    "@fastify/swagger-ui": "^5.2.0",
    "@sentry/node": "^10.0.0",
    "drizzle-orm": "^0.44.0",
    "fastify": "^5.4.0",
    "viem": "^2.33.0",
    "zod": "^3.25.0",
    "@belk/chain": "workspace:*",
    "@fastify/rate-limit": "^10.3.0",
    "fastify-type-provider-zod": "^4.0.2",
    "ioredis": "^5.6.0",
    "bullmq": "^5.56.0",
    "@belk/onramp": "workspace:*"
  },
  "devDependencies": {
    "tsx": "^4.20.0"
  },
  "main": "./dist/app.js",
  "exports": {
    "./app": {
      "types": "./dist/app.d.ts",
      "default": "./dist/app.js"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "default": "./dist/config.js"
    },
    "./signer": {
      "types": "./dist/signer/index.d.ts",
      "default": "./dist/signer/index.js"
    }
  }
}
