# Server-side URL of the ClearGateway API (used by the dashboard/admin proxy)
API_BASE_URL=http://localhost:3000
# Browser-side URL of the ClearGateway API (hosted checkout calls it directly; the API's CHECKOUT_ORIGIN must match this app's origin)
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000
# Encrypts the login cookie. Min 32 chars. Generate: openssl rand -hex 32
SESSION_SECRET=
